+    c = _fit_cap(text, cap, max_w * 1.9 if " " in text else max_w)
+    return E_text(text, x, y, c, align=align, color=color, anchor=_an(spec, f"label{i}"), max_width=max_w,
+                  seed=spec.seed * 5 + i, impact=impact, importance=importance)
