+    "$": (0.64, [arc(0.32, 0.27, 0.28, 0.23, -35, -270, 12) + arc(0.32, 0.73, 0.3, 0.23, -90, 145, 12)[1:], [(0.32, -0.08), (0.32, 1.08)]]),
+    "&": (0.84, [[(0.74, 1.0), (0.12, 0.34), (0.2, 0.06), (0.4, 0.04), (0.5, 0.2), (0.34, 0.5), (0.05, 0.72),
+                  (0.12, 0.96), (0.4, 1.0), (0.66, 0.72)]]),
